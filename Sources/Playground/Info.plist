<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>LerpPlayground</string>
	<key>CFBundleIconFile</key>
	<string>LerpPlayground</string>
	<!-- The base identifier. The Makefile gives staging a `.build` identifier and
	     the canonical ~/Applications copy an `.installed` identifier, then launches
	     only the latter. A bundle identifier is what lets macOS deduplicate runs. -->
	<key>CFBundleIdentifier</key>
	<string>com.hergenroeder.lerping.playground</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Deliberately the same string as the bundle folder and the executable, so
	     the menu bar, ⌘-Tab, the Dock, Finder and `open -a LerpPlayground` all
	     call it the same thing. -->
	<key>CFBundleName</key>
	<string>LerpPlayground</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- Deployment may ask this app to quit because the delegate protects dirty
	     editor text with Save / Discard / Cancel. Older builds lack that hook and
	     are refused until the user closes them once. -->
	<key>LerpSafeDeploymentQuit</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Lerping@Home. AGPL-3.0-or-later — see LICENSE.</string>
</dict>
</plist>
