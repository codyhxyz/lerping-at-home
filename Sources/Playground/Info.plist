<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>LerpPlayground</string>
	<key>CFBundleIconFile</key>
	<string>LerpPlayground</string>
	<!-- The whole point of the bundle. macOS deduplicates launches, resolves
	     `open -a`, files preferences and hands out a Dock tile by this string;
	     with no bundle there was no identifier, and so every launch was another
	     app with another window. Same domain as the saver's. -->
	<key>CFBundleIdentifier</key>
	<string>com.hergenroeder.lerping.playground</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Deliberately the same string as the bundle folder and the executable, so
	     the menu bar, ⌘-Tab, the Dock, Finder and `open -a LerpPlayground` all
	     call it the same thing. -->
	<key>CFBundleName</key>
	<string>LerpPlayground</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Lerping@Home. GPL-3.0-or-later — see LICENSE.</string>
</dict>
</plist>
