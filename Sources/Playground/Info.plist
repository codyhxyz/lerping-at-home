<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>LerpPlayground</string>
	<key>CFBundleIconFile</key>
	<string>LerpPlayground</string>
	<!-- The base identifier. The Makefile gives staging a `.build` identifier and
	     the canonical ~/Applications copy an `.installed` identifier, then launches
	     only the latter. A bundle identifier is what lets macOS deduplicate runs. -->
	<key>CFBundleIdentifier</key>
	<string>com.hergenroeder.lerping.playground</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Deliberately the same string as the bundle folder and the executable, so
	     the menu bar, ⌘-Tab, the Dock, Finder and `open -a LerpPlayground` all
	     call it the same thing. -->
	<key>CFBundleName</key>
	<string>LerpPlayground</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.hergenroeder.lerping.open</string>
			<key>CFBundleURLSchemes</key>
			<array><string>lerp</string></array>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key><string>Lerp Look</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>LSItemContentTypes</key><array><string>com.hergenroeder.lerping.look</string></array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key><string>Lerp Playlist</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>LSItemContentTypes</key><array><string>com.hergenroeder.lerping.playlist</string></array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key><string>Lerp Piece</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>LSItemContentTypes</key><array><string>com.hergenroeder.lerping.piece</string></array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key><string>com.hergenroeder.lerping.look</string>
			<key>UTTypeDescription</key><string>Lerp Look</string>
			<key>UTTypeConformsTo</key><array><string>public.json</string></array>
			<key>UTTypeTagSpecification</key>
			<dict><key>public.filename-extension</key><array><string>lerplook</string></array></dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key><string>com.hergenroeder.lerping.playlist</string>
			<key>UTTypeDescription</key><string>Lerp Playlist</string>
			<key>UTTypeConformsTo</key><array><string>public.json</string></array>
			<key>UTTypeTagSpecification</key>
			<dict><key>public.filename-extension</key><array><string>lerpplaylist</string></array></dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key><string>com.hergenroeder.lerping.piece</string>
			<key>UTTypeDescription</key><string>Lerp Piece</string>
			<key>UTTypeConformsTo</key><array><string>public.zip-archive</string></array>
			<key>UTTypeTagSpecification</key>
			<dict><key>public.filename-extension</key><array><string>lerppiece</string></array></dict>
		</dict>
	</array>
	<!-- Deployment may ask this app to quit because the delegate protects dirty
	     editor text with Save / Discard / Cancel. Older builds lack that hook and
	     are refused until the user closes them once. -->
	<key>LerpSafeDeploymentQuit</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- Shown by the System Audio Recording prompt the first time Shader ›
	     React to System Audio is turned on. Without it TCC refuses process
	     taps outright, which is also why the saver cannot have this: its host,
	     Apple's legacyScreenSaver, carries no such key. -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>LerpPlayground listens to the audio your Mac is playing so shaders can react to it. Only loudness levels are computed; nothing is recorded or saved.</string>
	<!-- Shown the first time either camera input is turned on: Shader › Track
	     Head with Camera or Shader › MIDI › Control with Hands. Without it TCC
	     terminates the app on first camera access. -->
	<key>NSCameraUsageDescription</key>
	<string>LerpPlayground can follow your head, so looks become a window onto a 3D scene, or your hands, so a pinch can turn a shader's knobs. Frames are only used for that on this Mac; nothing is recorded, saved or sent.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Lerping@Home. AGPL-3.0-or-later — see LICENSE.</string>
</dict>
</plist>
