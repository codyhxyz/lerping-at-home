<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Release builds only: the hardened runtime refuses the camera to an app
     without this, and Shader › Control with Hands needs it. Local builds are
     ad-hoc signed without the hardened runtime and need no entitlements. -->
<dict>
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
